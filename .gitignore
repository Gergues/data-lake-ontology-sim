# ---------------------------------------------------------------------------
# Data Lake Simulation — .gitignore
# ---------------------------------------------------------------------------

# --- Generated lake output (rebuilt anytime via `python run.py --stage all`) ---
data/

# --- Generated presentation deck (rebuilt via `python slides_maker.py`) ---
# Comment the next line out if you want to commit the built slides.
#slides/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
venv/
.venv/
env/
.env
env.bak/
venv.bak/
ENV/

# ---------------------------------------------------------------------------
# Jupyter / IPython
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
# Keep shared VS Code settings/tasks if you use them; ignore user-specific files.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Temp / scratch files
# ---------------------------------------------------------------------------
*.log
*.tmp
*.bak
verify_tmp.py
